NODE_ENV=development
PORT=5000

# Comma-separated list of allowed frontend origins, e.g.
# "http://localhost:5000,https://myfarmora.app". Not needed when the backend
# serves the frontend itself (the default: http://localhost:5000).
CLIENT_ORIGIN=http://localhost:5000

# Your Groq API key. Server-side only — never sent to the browser.
GROQ_API_KEY=
# Optional: override the Groq model (defaults to qwen/qwen3.6-27b, the
# vision-capable model the frontend uses for chat + image analysis)
GROQ_MODEL=qwen/qwen3.6-27b

# MongoDB connection string (Phase 2: farmer profiles, farms, diagnosis/chat
# history; Phase 3: RAG knowledge-base vector storage). Optional — if unset,
# the server still starts and /api/chat and /api/analyze keep working;
# profile/farm/history/knowledge-search routes return 503 instead.
# Example (local): mongodb://127.0.0.1:27017/farmora
# Example (Atlas):  mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/farmora
MONGODB_URI=

# DNS servers used to resolve the MongoDB Atlas SRV record before connecting
# (see backend/src/config/db.js). Fixes environments where the default OS
# resolver can't resolve `_mongodb._tcp.*` SRV records (symptom: `querySrv
# ECONNREFUSED _mongodb._tcp.<cluster>...`). Comma-separated. Defaults to
# Google Public DNS if unset — only change this if you have a reason to
# (e.g. a corporate DNS server that *can* resolve it).
MONGODB_DNS_SERVERS=8.8.8.8,8.8.4.4

# ---- Phase 3: RAG (retrieval-augmented generation) ----
# The knowledge base's vector store reuses MONGODB_URI above — no separate
# VECTOR_DB_URL/VECTOR_DB_KEY needed (see README "Vector database choice").

# 'local' (default): no external calls, deterministic hashing-based
# embedding — works fully offline, good enough for keyword-ish retrieval,
# and does NOT require any API key to run or to run tests. It is a
# lightweight local/testing approach, not a substitute for a real semantic
# embedding model — see README "Embedding model choice".
# 'openai': real semantic embeddings via OpenAI — needs OPENAI_API_KEY.
# The provider is only ever switched by this setting — never silently.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=

# Retrieval tuning. Defaults suit EMBEDDING_PROVIDER=local; raise
# RAG_SIMILARITY_THRESHOLD substantially (e.g. 0.75) if you switch to
# EMBEDDING_PROVIDER=openai, since real semantic embeddings produce much
# more meaningful cosine similarity scores than the local hashed fallback.
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.12
